# Sprache der Google-Fotos-Oberfläche (aria-labels Share/Download: „Teilen“, „Alle herunterladen“)
GOOGLE_LANG=de

# Ziel im Container; Host-Pfad über DATA_DIR (Compose-Volume)
OUTPUT_ROOT=/data/shared

HTTP_PORT=8090
POLL_SECONDS=30
WEB_DRIVER_WAIT=25
DOWNLOAD_TIMEOUT=1800

CHROME_BINARY=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver
HEADLESS=true
SKIP_EXISTING=true

# Host-Pfad zur NAS-Freigabe, z. B. /volume1/photos/gphotos-album-sync
# Ergebnis: $DATA_DIR/shared/<Albumname>/
DATA_DIR=./data

# Optional andere Host-Pfade für Queue / Chrome-Profil
# QUEUE_HOST=./queue
# PROFILE_HOST=./profile

# Private Alben (nicht der Normalfall): Profil-Ordner befüllen und auf true setzen
USE_CHROME_PROFILE=false

# Bei Fehlern Screenshot + HTML nach queue/debug/ schreiben
DEBUG_DUMPS=false
